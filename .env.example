# Django Settings
DEBUG=1
SECRET_KEY=django-insecure-artisanal-reserve-production-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# MySQL 8 Database Configuration
MYSQL_DATABASE=coffee_reserve_db
MYSQL_USER=coffee_user
MYSQL_PASSWORD=coffeepassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Chapa Payment Gateway (ETB Currency)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_test_secret_key
# Chapa signs webhooks with this secret. It MUST be set: an unsigned webhook is
# rejected, and without this the payment webhook cannot be verified at all.
# Get it from the Chapa dashboard under Settings > API Keys > Webhook Secret.
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_key
# Where Chapa sends its server-to-server callback. Must be the API host, not the
# frontend - the webhook carries no customer cookie and the frontend origin is not
# reachable from the internet during development.
BACKEND_PUBLIC_URL=http://localhost:8000
# Seconds to wait on the gateway when verifying a transaction.
CHAPA_VERIFY_TIMEOUT=15
CHAPA_API_URL=https://api.chapa.co/v1
# Address Chapa uses for the receipt when a customer's email domain cannot receive
# mail. Must be a real, deliverable mailbox domain (Chapa rejects placeholder ones).
CHAPA_FALLBACK_EMAIL=payments@yourdomain.com
# Set to False to allow signups without checking that the email domain exists.
REQUIRE_EMAIL_MX=True

# ── AI Assistant ──────────────────────────────────────────────────────
# Optional. With neither of these set the assistant still answers every question
# from the live menu, venue settings and reservations - it just uses the
# deterministic engine instead of the conversational model.
#
# Set the key and the flag to let Gemini run the conversation. It still reads
# every price, availability and booking state through tools, and its replies are
# checked against those tool results before being sent, so an unsourced figure or
# an unconfirmed booking falls back to the deterministic answer.
GEMINI_API_KEY=
ASSISTANT_USE_LLM=False
# ASSISTANT_MODEL=gemini-2.5-flash
# ASSISTANT_LLM_TIMEOUT=20

# Frontend API Endpoint Configuration
# The browser calls same-origin /api/v1/... and Next.js proxies them; this is only the
# address used by server-side code and the proxy target.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the Next.js server proxies /api/v1 and /media. Inside docker-compose this must
# be the backend service name; running `npm run dev` on the host it is localhost.
INTERNAL_BACKEND_URL=http://localhost:8000
# Shows the seeded admin/manager/customer logins on the sign-in form. Leave false
# anywhere real: it renders the staff passwords on the page.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
